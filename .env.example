# ==============================================================================
# Autonomous Competitor Intelligence & Outreach Pipeline - Environment Configuration
# ==============================================================================

# LLM Providers (Configure at least one API key)
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# LLM Model Selector
# Examples: "gpt-4o-mini", "gpt-4o", "gemini/gemini-1.5-flash", "groq/llama-3.3-70b-versatile"
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Crawler Engine Settings
CRAWLER_HEADLESS=true
CRAWLER_CONCURRENCY=5
CRAWLER_PAGE_TIMEOUT_MS=30000
CRAWLER_WORD_COUNT_THRESHOLD=15
MAX_SUBPAGES_PER_DOMAIN=3

# Cold Outreach Configuration
# "en" for English, "fa" for Persian
DEFAULT_OUTREACH_LANGUAGE=en
RATE_LIMIT_DELAY_SECONDS=1.0
